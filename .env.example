GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model viết kịch bản (cũng dùng làm Vision model nếu không đặt GEMINI_VISION_MODEL)
GEMINI_MODEL=gemini-3.1-flash-lite
# Model kiểm duyệt ảnh và khoảng cách tối thiểu giữa 2 lần gọi (ms)
GEMINI_VISION_MODEL=
GEMINI_VISION_INTERVAL_MS=8000
# Model tạo ảnh AI khi không tìm được ảnh tư liệu phù hợp
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Nguồn ảnh (không bắt buộc). Wikimedia Commons và NASA không cần key.
PEXELS_API_KEY=
PIXABAY_API_KEY=
SMITHSONIAN_API_KEY=

# Giọng đọc (hiện chỉ hỗ trợ elevenlabs)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Có thể tắt ảnh hoặc giọng đọc bằng false
GENERATE_IMAGES=true
GENERATE_VOICE=true
