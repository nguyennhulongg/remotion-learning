      "end": 67.89159615384615,
      "text": "nhạc của cá voi luôn luôn mới mẻ"
    },
    {
      "start": 67.89159615384615,
      "end": 68.63820833333334,
      "text": "và sống động."
    },
    {
      "start": 68.63820833333334,
      "end": 70.09978348670757,
      "text": "Việc hiểu được ngôn ngữ này"
    },
    {
      "start": 70.09978348670757,
      "end": 71.83202070552147,
      "text": "không chỉ là khoa học, mà còn là"
    },
    {
      "start": 71.83202070552147,
      "end": 73.45599309815951,
      "text": "sự kết nối với trí tuệ cổ xưa."
    },
    {
      "start": 73.45599309815951,
      "end": 75.18823031697342,
      "text": "Đại dương không bao giờ im lặng,"
    },
    {
      "start": 75.18823031697342,
      "end": 76.92046753578732,
      "text": "nó chỉ đang chờ chúng ta thực sự"
    },
    {
      "start": 76.92046753578732,
      "end": 77.46179166666667,
      "text": "lắng nghe."
    },
    {
      "start": 77.46179166666667,
      "end": 79.19973498498499,
      "text": "Nếu điều này khiến bạn nhìn thế"
    },
    {
      "start": 79.19973498498499,
      "end": 80.76949024024024,
      "text": "giới khác đi, hãy để lại suy"
    },
    {
      "start": 80.76949024024024,
      "end": 82.50743355855856,
      "text": "nghĩ bên dưới và theo dõi FACTS"
